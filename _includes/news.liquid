<div class="news">
  {% assign news_docs = nil %}

  {% if site.collections and site.collections.news %}
    {% assign news_docs = site.collections.news.docs %}
  {% elsif site.news != blank %}
    {% assign news_docs = site.news %}
  {% endif %}

  {% if news_docs and news_docs != empty %}
    {% assign news_size = news_docs | size %}
    {% assign news = news_docs | sort: "date" | reverse %}

    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}

        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.title and item.title != "" and item.title != ":" %}
                <strong>{{ item.title }}</strong>{% if item.content %} — {% endif %}
              {% endif %}
              {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>