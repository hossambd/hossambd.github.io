<div class="teaching">
  {% assign teaching_docs = site.teaching %}

  {% if teaching_docs and teaching_docs != empty %}
    {% assign teaching_size = teaching_docs | size %}
    {% assign teaching = teaching_docs | sort: 'date' | reverse %}

    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% assign teaching_limit = teaching_size %}

        {% for item in teaching limit: teaching_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.year | default: item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.title and item.title != '' %}
                <strong>{{ item.title }}</strong>
                {%- if item.institution %} — {{ item.institution }}{% endif %}
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No teaching entries so far...</p>
  {% endif %}
</div>
